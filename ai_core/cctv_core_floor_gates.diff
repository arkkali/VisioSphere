+    Fails OPEN — a camera with no floor polygon returns True — so drawing the
+    zone is what switches the gate on, one camera at a time.
+    """
+    zones = [z for z in _FURNITURE_ZONES.get(cam_id, ())
+             if _is_floor_zone(z["name"])]
+    if not zones:
