# Disable the IP camera during testing
CAM_1_ID=
CAM_1_SOURCE=

# LOCAL backend — keeps test alerts out of production MongoDB
BACKEND_URL=http://localhost:5000

# MUST match the test videos' native 720x480 (3:2). 1280x720 is 16:9, which
# stretches every frame horizontally ~18% and makes a supine body flatter than it
# really is — the exact direction that stops YOLO-pose detecting a person on the
# floor. This one line is what made the lying-down detection start working.
#
# It lives here as well as in .env on purpose: the workflow at the top of this
# file is `copy .env.test .env`, so anything set only in .env is silently wiped
# every time you switch test videos.

CLIP_PREROLL_S=5
CLIP_POSTROLL_S=5
CLIP_FPS=10
CLIP_COOLDOWN_S=5
CLIP_DIR=../backend/uploads/clips

